{
  "manifest_version": 3,
  "name": "Spice for GitHub",
  "short_name": "Spice",
  "version": "0.1.0",
  "description": "Render valid Spice declaration comments as native, highlighted annotations on GitHub.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "assets/logo-16.png",
    "32": "assets/logo-32.png",
    "48": "assets/logo-48.png",
    "128": "assets/logo-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["styles.css"],
      "js": ["spice-syntax.js", "settings.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/logo-16.png", "assets/logo-32.png"],
      "matches": ["https://github.com/*"]
    }
  ]
}
